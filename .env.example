# Local PostgreSQL (the defaults match `pnpm db:start` and docker compose).
DATABASE_URL=postgresql://palletdock:palletdock_dev_only@127.0.0.1:55432/palletdock
PALLETDOCK_DB_PORT=55432
PALLETDOCK_DB_USER=palletdock
PALLETDOCK_DB_PASSWORD=palletdock_dev_only
PALLETDOCK_DB_NAME=palletdock

# API and browser app.
API_HOST=127.0.0.1
API_PORT=4100
WEB_ORIGIN=http://127.0.0.1:3000
PALLETDOCK_API_URL=http://127.0.0.1:4100
SESSION_COOKIE_SECURE=0
# Replace with a random value of at least 32 bytes outside local development.
PALLETDOCK_CURSOR_SECRET=replace-with-a-random-32-byte-secret

# Self-service accounts: disabled (default), invite, or open. Invite mode is
# recommended for hosted demos. Keep the invite code server-side and use at
# least 16 characters. Open mode needs deployment-level abuse controls.
# Shared by the web proxy and the API so rate limits apply per visitor behind a hosting proxy
# (at least 32 characters; set the same value for both). Leave unset for local development.
# PALLETDOCK_PROXY_SECRET=

PALLETDOCK_SIGNUP_MODE=disabled
# PALLETDOCK_SIGNUP_INVITE_CODE=replace-with-a-random-registration-code
# PALLETDOCK_SIGNUP_RATE_LIMIT_PER_15_MINUTES=5

# Portaldot RPC targets are allowlisted by packages/shared/src/network.ts.
PORTALDOT_EVM_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_SUBSTRATE_RPC_URL=wss://test-node-v3.portaldot.dev

# Worker: blocks to stay behind the chain head before indexing (default 3). The RPC node can report
# a block before its logs are queryable; 0 is only safe on a local chain such as the E2E Hardhat node.
# PALLETDOCK_INDEX_LAG_BLOCKS=3

# Optional server-side consumer demo. Keep the read key out of NEXT_PUBLIC_*.
# PALLETDOCK_CONSUMER_API_URL=http://127.0.0.1:4100
# PALLETDOCK_CONSUMER_PROJECT_ID=<project-uuid>
# PALLETDOCK_CONSUMER_READ_KEY=<read-key-created-in-the-workspace>
# PALLETDOCK_CONSUMER_CONTRACT=<0x-contract-address>
# PALLETDOCK_CONSUMER_EVENT=NumberChanged
# PALLETDOCK_CONSUMER_PUBLIC=0
