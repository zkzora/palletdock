# Local PostgreSQL (the defaults match `pnpm db:start` and docker compose).
DATABASE_URL=postgresql://palletdock:palletdock_dev_only@127.0.0.1:55432/palletdock
PALLETDOCK_DB_PORT=55432
PALLETDOCK_DB_USER=palletdock
PALLETDOCK_DB_PASSWORD=palletdock_dev_only
PALLETDOCK_DB_NAME=palletdock

# API and browser app.
API_HOST=127.0.0.1
API_PORT=4100
WEB_ORIGIN=http://127.0.0.1:3000
SESSION_COOKIE_SECURE=0
# Replace with a random value of at least 32 bytes outside local development.
PALLETDOCK_CURSOR_SECRET=replace-with-a-random-32-byte-secret

# Portaldot RPC targets are allowlisted by packages/shared/src/network.ts.
PORTALDOT_EVM_RPC_URL=https://testnetv3-eth-rpc.feso-apps.xyz
PORTALDOT_SUBSTRATE_RPC_URL=wss://testnetv3-node.feso-apps.xyz

# Optional non-interactive bootstrap. Prefer the prompt for normal use.
# PALLETDOCK_OWNER_PASSWORD=replace-with-at-least-12-characters
