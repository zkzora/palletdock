# Runtime image for Railway's API and worker services. The service role is
# selected at runtime with PALLETDOCK_SERVICE=api or PALLETDOCK_SERVICE=worker.
FROM node:22-bookworm-slim

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=1

RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
COPY packages/chain/package.json packages/chain/
COPY packages/contracts/package.json packages/contracts/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/
COPY packages/e2e-chain/package.json packages/e2e-chain/
# Install before NODE_ENV=production: with it set, pnpm skips devDependencies, and the
# services, migrations, and owner CLI all run through tsx (a root devDependency).
# Only the API, the worker, their workspace dependencies, and the root are installed: the web
# app (Next.js) and the Hardhat fixture chain are not needed here, and every extra download is
# another chance for a registry timeout to fail the build. Longer fetch retries cover the rest.
RUN pnpm install --frozen-lockfile \
      --filter "@palletdock/api..." --filter "@palletdock/worker..." --filter "{.}" \
      --fetch-retries=5 --fetch-timeout=120000 --fetch-retry-maxtimeout=120000
# Containers start through deploy/*.sh with tsx directly; should pnpm still run a script,
# it must not "repair" the intentionally partial install by downloading the rest.
ENV NODE_ENV=production \
    pnpm_config_verify_deps_before_run=false

COPY . .

CMD ["sh", "/app/deploy/railway-start.sh"]
