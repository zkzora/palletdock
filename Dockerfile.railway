# Runtime image for Railway's API and worker services. The service role is
# selected at runtime with PALLETDOCK_SERVICE=api or PALLETDOCK_SERVICE=worker.
FROM node:22-bookworm-slim

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=1

RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
COPY packages/chain/package.json packages/chain/
COPY packages/contracts/package.json packages/contracts/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/
COPY packages/e2e-chain/package.json packages/e2e-chain/
# Install before NODE_ENV=production: with it set, pnpm skips devDependencies, and the
# services, migrations, and owner CLI all run through tsx (a root devDependency).
RUN pnpm install --frozen-lockfile
ENV NODE_ENV=production

COPY . .

CMD ["sh", "/app/deploy/railway-start.sh"]
